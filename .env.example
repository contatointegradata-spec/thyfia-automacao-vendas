# Copie para .env e preencha. O .env nunca deve ir para o git.
# A maior parte da configuração (Kiwify, n8n, Evolution, Telegram, suporte) agora é feita
# em tela: menu Administração → Configurações. O .env serve só para o servidor.

# Conta administradora (dono da plataforma). Se vazio, a conta mais antiga vira administradora.
THYFIA_ADMIN_EMAIL=
# Chave que protege os tokens dos clientes no banco (Fernet). Se vazia, é gerada em dados/.chave_cofre.
# Se definir, NÃO troque depois (os tokens salvos deixariam de abrir). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THYFIA_SECRET_KEY=

# Cópia local da planilha em dados/planilhas (1 = salvar, 0 = não salvar). Os dados ficam no banco.
THYFIA_SALVAR_PLANILHA=1
# Apagar planilhas locais com mais de N dias (0 = desligado)
THYFIA_LIMPAR_PLANILHAS_DIAS=0

# endereço público deste ThyfIA (domínio/túnel), necessário para publicar fotos enviadas pela tela
THYFIA_URL_PUBLICA=
# 0 desliga o agendador de posts (padrão ligado)
THYFIA_AGENDADOR=1
IG_GRAPH_HOST=https://graph.facebook.com
IG_GRAPH_VERSION=v21.0
# de onde vem a foto do post: ml_direct (CDN do Mercado Livre) | proprio (futuro: VPS)
IG_IMAGE_HOST=ml_direct

# --- Opcional / só para uso pessoal do administrador (fallback; clientes usam as telas) ---
# N8N_WEBHOOK_URL=
# N8N_API_KEY=
# IG_ACCESS_TOKEN=
# IG_USER_ID=

# --- Produção (VPS) — só no .env da VPS ---
# Rede Docker em que o nginx da VPS está (o container da ThyfIA entra nela)
PROXY_NETWORK=
